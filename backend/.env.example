# Copy to .env and fill in. .env is gitignored, this file is not.

# Required. Any long random string. The API refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional. Defaults to mongodb://localhost:27017/blog
MONGO_URI=

# Optional. Defaults to http://localhost:7000/ where the Flask sanitiser runs.
NLP_URL=

# Optional. Comma separated list of allowed frontend origins.
# Unset means allow any origin, which is what local development wants.
CORS_ORIGIN=

# Optional. Hosts usually set this themselves. Defaults to 5000.
PORT=
